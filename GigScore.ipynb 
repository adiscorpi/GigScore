    "---\n## Step 8 — PLFS Income Benchmarking & Inflation Flag\n\n### What Is PLFS?\nThe **Periodic Labour Force Survey (PLFS)** from MoSPI provides government-validated\nincome benchmarks by occupation and state tier. We use it to flag applicants\nwhose reported income is implausibly high vs the PLFS median for their\noccupation type — a powerful **income fraud detection** signal.\n\n> Source: PLFS Annual Report 2022-23, Table 25 (Self-employed, regular wage/salaried)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── PLFS 2022-23 annual income benchmarks by org type and region tier ─────\n# (₹ per annum — from PLFS microdata summary tables)\nPLFS_BENCHMARKS = {\n    # (ORGANIZATION_TYPE, region_tier) → median annual income ₹\n    ('Self-employed',      1): 270000,\n    ('Self-employed',      2): 216000,\n    ('Self-employed',      3): 162000,\n    ('Taxi / driver',      1): 216000,\n    ('Taxi / driver',      2): 180000,\n    ('Taxi / driver',      3): 144000,\n    ('Transport: type 1',  1): 240000,\n    ('Transport: type 1',  2): 192000,\n    ('Transport: type 1',  3): 156000,\n    ('Transport: type 2',  1): 220000,\n    ('Transport: type 2',  2): 180000,\n    ('Transport: type 2',  3): 150000,\n    ('Trade: type 1',      1): 300000,\n    ('Trade: type 1',      2): 240000,\n    ('Trade: type 1',      3): 180000,\n    ('Trade: type 2',      1): 252000,\n    ('Trade: type 2',      2): 204000,\n    ('Trade: type 2',      3): 156000,\n    ('Low-skill Laborers', 1): 168000,\n    ('Low-skill Laborers', 2): 144000,\n    ('Low-skill Laborers', 3): 120000,\n    ('Drivers',            1): 216000,\n    ('Drivers',            2): 180000,\n    ('Drivers',            3): 150000,\n}\n\ndef get_plfs_benchmark(row):\n    key = (row['ORGANIZATION_TYPE'], int(row['REGION_RATING_CLIENT']))\n    return PLFS_BENCHMARKS.get(key, 180000)  # fallback: ₹1.8L\n\nhf['plfs_benchmark_income'] = hf.apply(get_plfs_benchmark, axis=1)\nhf['income_vs_plfs_ratio']  = hf['AMT_INCOME_TOTAL'] / (hf['plfs_benchmark_income'] + 1)\n\n# Flag: income > 2.5× PLFS median = potential inflation\nhf['income_inflation_flag'] = (hf['income_vs_plfs_ratio'] > 2.5).astype(int)\n\n# Flag: income < 0.5× PLFS median = potential under-reporting (also suspicious)\nhf['income_underreport_flag'] = (hf['income_vs_plfs_ratio'] < 0.5).astype(int)\n\nn_inflate    = hf['income_inflation_flag'].sum()\nn_underreport= hf['income_underreport_flag'].sum()\nn_normal     = len(hf) - n_inflate - n_underreport\n\nprint(f\"  PLFS income validation results:\")\nprint(f\"    Normal income range        : {n_normal:>6,}  ({n_normal/len(hf):.1%})\")\nprint(f\"    Potential inflation (>2.5×): {n_inflate:>6,}  ({n_inflate/len(hf):.1%})\")\nprint(f\"    Potential under-report (<0.5×): {n_underreport:>5,}  ({n_underreport/len(hf):.1%})\")\nprint(f\"\\n  Mean income_vs_plfs_ratio by TARGET:\")\nprint(hf.groupby('TARGET')['income_vs_plfs_ratio'].mean().round(3))\n"
