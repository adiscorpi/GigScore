    "---\n## Step 6 — UPI Transaction Dataset: 8 Behavioural Velocity Features\n\nThis is GigScore's **core differentiator**. We engineer all 8 behavioural\nvelocity features described in the Master Plan — the signals that CIBIL\ncannot capture because they require transaction-level data.\n\n### The 8 Behavioural Velocity Features\n| Feature | What It Measures | Gig Worker Insight |\n|---------|------------------|--------------------|\n| `income_regularity_cv` | Coefficient of variation of monthly credits | CV 0.35 is normal for gig — not risky |\n| `utility_payment_streak` | Months with recurring utility payments | Streak > 6 = deep financial discipline |\n| `cash_crunch_recovery_speed` | Balance recovery speed after dips | Fast recovery = resilience, not default |\n| `spending_velocity` | Rate of spending change vs 90-day baseline | Sudden spike = early stress signal |\n| `merchant_diversity_score` | Shannon entropy of merchant categories | High diversity = stable lifestyle |\n| `inflow_outflow_ratio` | Total inflows / total outflows | > 1.2 = net saver despite irregular income |\n| `recurring_payment_ratio` | % payments to same payee 2+ consecutive months | Rootedness signal |\n| `obligation_fulfillment_rate` | % months all fixed obligations paid | Core creditworthiness signal |\n\n> **Production note:** In Mode 3 (Account Aggregator), these are computed\n> per individual applicant. Here we compute per sender_state as a\n> statistically valid regional proxy, then join on REGION_RATING_CLIENT.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Clean UPI column names ─────────────────────────────────────────────────\nupi.columns = (\n    upi.columns\n    .str.lower().str.strip()\n    .str.replace(' ', '_').str.replace('(', '').str.replace(')', '')\n)\n\n# ── Parse types ────────────────────────────────────────────────────────────\nupi['timestamp']  = pd.to_datetime(upi['timestamp'], errors='coerce')\nupi['month']      = upi['timestamp'].dt.to_period('M')\nupi['is_success'] = upi['transaction_status'].str.upper() == 'SUCCESS'\nupi['is_p2m']     = upi['transaction_type'].str.upper() == 'P2M'   # merchant pay\nupi['is_p2p']     = upi['transaction_type'].str.upper() == 'P2P'   # peer transfer\n\nprint(f\"  UPI dataset: {upi.shape}\")\nprint(f\"  Date range: {upi['timestamp'].min()} → {upi['timestamp'].max()}\")\nprint(f\"  States covered: {upi['sender_state'].nunique()}\")\nprint(f\"  Transaction types: {upi['transaction_type'].value_counts().to_dict()}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "monthly_flow_sorted = monthly_flow.sort_values(['sender_state','month'])\nmonthly_flow_sorted['next_txn_count'] = (\n    monthly_flow_sorted.groupby('sender_state')['txn_count'].shift(-1)\n)\n# Fix for pandas 2.x: groupby().apply() on a filtered frame returns a DataFrame.\n# Compute the ratio on the filtered rows directly, then aggregate with .mean().\ncrunch_rows = monthly_flow_sorted[monthly_flow_sorted['crunch'] == 1].copy()\ncrunch_rows['recovery_ratio'] = crunch_rows['next_txn_count'] / (crunch_rows['txn_count'] + 1e-6)\ncrunch_recovery = (\n    crunch_rows.groupby('sender_state')['recovery_ratio']\n    .mean()\n    .rename('cash_crunch_recovery_speed')\n)\n\nprint(\"  Features 1–3 computed.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════\n# FEATURE 4: spending_velocity\n#   Coefficient of variation of monthly P2M spending\n#   Sudden upward spike = financial stress early warning\n# ═══════════════════════════════════════════════════════════════════════════\nmonthly_spend = (\n    upi[upi['is_p2m']]\n    .groupby(['sender_state','month'])['amount_inr']\n    .sum()\n    .reset_index()\n)\nspending_velocity = (\n    monthly_spend.groupby('sender_state')['amount_inr']\n    .agg(lambda x: x.std() / (x.mean() + 1e-6))\n    .rename('spending_velocity')\n)\n\n# ═══════════════════════════════════════════════════════════════════════════\n# FEATURE 5: merchant_diversity_score\n#   Shannon entropy of merchant_category per state\n#   High entropy = diverse spending = stable full life\n#   Formula: -Σ p_i * log(p_i), normalised to [0,1]\n# ═══════════════════════════════════════════════════════════════════════════\ndef shannon_diversity(series):\n    counts = series.value_counts(normalize=True)\n    if len(counts) <= 1:\n        return 0.0\n    raw_entropy = entropy(counts)\n    max_entropy = np.log(len(counts))\n    return raw_entropy / max_entropy if max_entropy > 0 else 0.0\n\nmerchant_diversity = (\n    upi[upi['is_p2m']]\n    .groupby('sender_state')['merchant_category']\n    .apply(shannon_diversity)\n    .rename('merchant_diversity_score')\n)\n\n# ═══════════════════════════════════════════════════════════════════════════\n# FEATURE 6: inflow_outflow_ratio\n#   Total P2P inflows / total P2M outflows over full period\n#   > 1.2 = net saver; < 0.8 = spending more than receiving\n# ═══════════════════════════════════════════════════════════════════════════\nstate_totals = upi.groupby(['sender_state','transaction_type'])['amount_inr'].sum().unstack(fill_value=0)\nstate_totals.columns = [c.lower() for c in state_totals.columns]\nif 'p2p' not in state_totals.columns: state_totals['p2p'] = 0\nif 'p2m' not in state_totals.columns: state_totals['p2m'] = 0\ninflow_outflow = (\n    (state_totals['p2p'] / (state_totals['p2m'] + 1e-6))\n    .rename('inflow_outflow_ratio')\n)\n\nprint(\"  Features 4–6 computed.\")\n"
   ]
