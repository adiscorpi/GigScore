    "# ═══════════════════════════════════════════════════════════════════════════\n# FEATURE 7: recurring_payment_ratio\n#   % of P2M transactions going to a payee seen in 2+ consecutive months\n#   High ratio = stable fixed obligations consistently met (rent, supplier)\n# ═══════════════════════════════════════════════════════════════════════════\np2m_txns = upi[upi['is_p2m']].copy()\n\n# Use merchant_category as payee proxy (real AA data would have payee VPA)\nrecurring_by_state = {}\nfor state, grp in p2m_txns.groupby('sender_state'):\n    months = sorted(grp['month'].unique())\n    if len(months) < 2:\n        recurring_by_state[state] = 0.0\n        continue\n    recurring_cats = set()\n    for i in range(len(months) - 1):\n        cats_now  = set(grp[grp['month'] == months[i]]['merchant_category'])\n        cats_next = set(grp[grp['month'] == months[i+1]]['merchant_category'])\n        recurring_cats |= (cats_now & cats_next)\n    total_cats = len(grp['merchant_category'].unique())\n    recurring_by_state[state] = len(recurring_cats) / (total_cats + 1e-6)\n\nrecurring_payment_ratio = pd.Series(recurring_by_state, name='recurring_payment_ratio')\n\n# ═══════════════════════════════════════════════════════════════════════════\n# FEATURE 8: obligation_fulfillment_rate\n#   % of months where BOTH a recurring P2M AND a P2P inflow appear\n#   (proxy: person earned AND met fixed obligations that month)\n# ═══════════════════════════════════════════════════════════════════════════\nmonths_with_p2m = (\n    upi[upi['is_p2m']].groupby(['sender_state','month']).size()\n    .gt(0).reset_index(name='has_p2m')\n)\nmonths_with_p2p = (\n    upi[upi['is_p2p']].groupby(['sender_state','month']).size()\n    .gt(0).reset_index(name='has_p2p')\n)\nobligation_df = months_with_p2m.merge(months_with_p2p, on=['sender_state','month'], how='outer').fillna(False)\nobligation_df['both'] = obligation_df['has_p2m'] & obligation_df['has_p2p']\nobligation_fulfillment_rate = (\n    obligation_df.groupby('sender_state')['both']\n    .mean()\n    .rename('obligation_fulfillment_rate')\n)\n\nprint(\"  Features 7–8 computed.\")\n\n# ── Assemble UPI feature profile per state ─────────────────────────────────\nupi_features = pd.concat([\n    income_cv,\n    utility_streak,\n    crunch_recovery,\n    spending_velocity,\n    merchant_diversity,\n    inflow_outflow,\n    recurring_payment_ratio,\n    obligation_fulfillment_rate,\n], axis=1).reset_index().rename(columns={'sender_state': 'state'})\n\n# ── Additional base metrics per state ─────────────────────────────────────\nupi_base = upi.groupby('sender_state').agg(\n    upi_total_txns      =('transaction_id', 'count'),\n    upi_avg_amount      =('amount_inr', 'mean'),\n    upi_success_rate    =('is_success', 'mean'),\n    upi_fraud_rate      =('fraud_flag', 'mean'),\n    upi_weekend_ratio   =('is_weekend', 'mean'),\n    upi_unique_merchants=('merchant_category', 'nunique'),\n).reset_index().rename(columns={'sender_state': 'state'})\n\nupi_profile = upi_features.merge(upi_base, on='state', how='left')\n\nprint(f\"\\n  UPI feature profile shape: {upi_profile.shape}\")\nprint(\"  States:\", upi_profile['state'].nunique())\nprint(\"\\n  All 8 behavioural velocity features:\")\nbv_features = [\n    'income_regularity_cv', 'utility_payment_streak', 'cash_crunch_recovery_speed',\n    'spending_velocity', 'merchant_diversity_score', 'inflow_outflow_ratio',\n    'recurring_payment_ratio', 'obligation_fulfillment_rate'\n]\nprint(upi_profile[bv_features].describe().round(4).to_string())\n"
