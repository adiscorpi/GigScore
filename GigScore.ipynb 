   "source": [
    "# ── Map REGION_RATING_CLIENT (1/2/3) to state groups ─────────────────────\n# Region rating 1 = Tier 1 metros, 2 = Tier 2 cities, 3 = Tier 3 / rural\n# We assign each UPI state to a region tier based on known geography\nTIER_MAP = {\n    1: ['Maharashtra', 'Karnataka', 'Delhi', 'Tamil Nadu', 'Telangana', 'Gujarat'],  # Tier 1\n    2: ['Rajasthan', 'Madhya Pradesh', 'Uttar Pradesh', 'Punjab', 'Haryana',\n        'Kerala', 'West Bengal'],                                                      # Tier 2\n    3: ['Bihar', 'Odisha', 'Chhattisgarh', 'Jharkhand', 'Assam',\n        'Himachal Pradesh', 'Uttarakhand', 'Goa'],                                    # Tier 3\n}\n\n# Build reverse map: state → region_rating\nstate_to_region = {}\nfor rating, states in TIER_MAP.items():\n    for s in states:\n        state_to_region[s] = rating\n\nupi_profile['region_rating'] = upi_profile['state'].map(state_to_region)\nupi_profile['region_rating'] = upi_profile['region_rating'].fillna(2)  # default Tier 2\n\n# ── Average UPI features per region tier ─────────────────────────────────\nUPI_FEATURE_COLS = bv_features + [\n    'upi_success_rate', 'upi_fraud_rate', 'upi_weekend_ratio',\n    'upi_unique_merchants'\n]\n\nupi_by_region = (\n    upi_profile.groupby('region_rating')[UPI_FEATURE_COLS]\n    .mean()\n    .rename(columns=lambda c: f'upi_{c}' if not c.startswith('upi_') else c)\n    .reset_index()\n    .rename(columns={'region_rating': 'REGION_RATING_CLIENT'})\n)\n\n# ── Join to gig worker cohort ────────────────────────────────────────────\nhf = hf.merge(upi_by_region, on='REGION_RATING_CLIENT', how='left')\n\nprint(f\"  Shape after UPI merge: {hf.shape}\")\nprint(\"\\n  UPI features non-constant check:\")\nupi_new_cols = [c for c in hf.columns if 'upi_' in c or c in bv_features]\nfor col in upi_new_cols[:12]:\n    nuniq = hf[col].nunique()\n    print(f\"    {col:40s}  unique: {nuniq}  ({'✅' if nuniq > 1 else '❌'})\")\n"
